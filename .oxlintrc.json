{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error"
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "plugins": ["react", "jsx-a11y", "import"],
  "settings": {
    "jsx-a11y": {
      "plugins": ["jsx-a11y"]
    }
  },
  "ignorePatterns": ["dist", "node_modules", "contracts", "target"]
}
